<?xml version="1.0" encoding="utf-8"?>
<!-- 导入题库 · 选列对话框 · UI 重设计（ID 与交互逻辑不变） -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/tv_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_field_soft"
            android:padding="10dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            style="@style/Text.FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="题目所在列" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:paddingLeft="10dp"
            android:paddingRight="6dp">

            <Spinner
                android:id="@+id/spinner_question"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null" />
        </FrameLayout>

        <TextView
            style="@style/Text.FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="答案所在列" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:paddingLeft="10dp"
            android:paddingRight="6dp">

            <Spinner
                android:id="@+id/spinner_answer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null" />
        </FrameLayout>

        <CheckBox
            android:id="@+id/check_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="首行是表头（不导入）"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            style="@style/Text.FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="内容预览（前 3 行，每列最多显示 14 字）" />

        <TextView
            android:id="@+id/tv_sample"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_field_soft"
            android:padding="10dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:typeface="monospace" />

    </LinearLayout>
</ScrollView>
