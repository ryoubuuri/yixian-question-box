<?xml version="1.0" encoding="utf-8"?>
<!--
  悬浮窗 · UI 重设计（2026-09）
  深色玻璃卡：渐变主按钮 + 深色次按钮；ID 与功能不变
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="270dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_float_card"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="题库助手"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_float_inner">

        <TextView
            android:id="@+id/tv_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="点击【截屏搜题】获取答案"
            android:textColor="@color/float_text_sub"
            android:textSize="13sp"
            android:textIsSelectable="true" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_capture"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1.6"
            android:background="@drawable/bg_float_btn_primary"
            android:stateListAnimator="@null"
            android:text="截屏搜题"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="false" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_settings"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_float_btn_dark"
            android:stateListAnimator="@null"
            android:text="设置"
            android:textColor="@color/float_text_sub"
            android:textSize="12sp"
            android:textAllCaps="false" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_close"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_float_btn_dark"
        android:stateListAnimator="@null"
        android:text="关闭"
        android:textColor="@color/danger"
        android:textSize="12sp"
        android:textAllCaps="false" />
</LinearLayout>
