<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen crop overlay shown right after a capture in SELECT mode.
     UI 重设计：底部操作条换新按钮样式（ID 不变） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0000000"
    android:orientation="vertical">

    <!-- Touchable canvas: bitmap + dim mask + draggable selection rect. -->
    <com.example.searchhelper.RegionCanvasView
        android:id="@+id/canvas_region"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="拖动框选要识别的屏幕区域" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F2171826"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:text="拖动调整选框：空白处拖动新建，框内拖动移动，四角可缩放；只识别框内内容。"
            android:textColor="@color/float_text_sub"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_cancel_region"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_float_btn_dark"
                android:stateListAnimator="@null"
                android:text="取消"
                android:textColor="@color/float_text_sub"
                android:textSize="14sp"
                android:textAllCaps="false" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_full_region"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_float_btn_dark"
                android:stateListAnimator="@null"
                android:text="全屏"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textAllCaps="false" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_ok_region"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_float_btn_primary"
                android:stateListAnimator="@null"
                android:text="确定识别"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
