<?xml version="1.0" ?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F5F7F5">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="一贤题匣" android:textSize="28sp" android:textColor="#182431" android:layout_marginBottom="12dp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="自己的题库，随手就能查" android:textSize="14sp" android:textColor="#708078" android:layout_marginBottom="12dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/tab_bank" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginBottom="16dp" android:text="题库" android:textColor="#206E60" android:backgroundTint="#E8F3EF"/>
            <Button android:id="@+id/tab_settings" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginBottom="16dp" android:text="设置" android:textColor="#206E60" android:backgroundTint="#E8F3EF"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/page_bank" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@drawable/yx_card">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="我的题库" android:textSize="20sp" android:textColor="#182431" android:layout_marginBottom="12dp" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="导入资料后，截屏即可优先查找本地答案。" android:textSize="14sp" android:textColor="#708078" android:layout_marginBottom="12dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:textColor="#182431" android:layout_marginBottom="12dp" android:id="@+id/tv_status"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_import" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="10dp" android:background="@drawable/yx_primary" android:text="＋  导入题库" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="15sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="JSONL · Excel · CSV 支持导入预览、答案选项和解析" android:textSize="13sp" android:textColor="#708078" android:layout_marginBottom="12dp"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_start" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="10dp" android:background="@drawable/yx_primary" android:text="开启悬浮搜题" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="15sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="小浮球常驻屏幕边缘，点击取题，结果可收起。" android:textSize="13sp" android:textColor="#708078" android:layout_marginBottom="12dp"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_clear" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="10dp" android:background="@drawable/yx_soft" android:text="清空已导入题库" android:textAllCaps="false" android:textColor="#206E60" android:textSize="15sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/page_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@drawable/yx_card" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="识别设置" android:textSize="20sp" android:textColor="#182431" android:layout_marginBottom="12dp" android:textStyle="bold"/>
            <Spinner android:id="@+id/spinner_region" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="12dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="13sp" android:textColor="#182431" android:layout_marginBottom="12dp" android:id="@+id/tv_region_hint"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_clear_region" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="10dp" android:background="@drawable/yx_soft" android:text="清除记忆区域" android:textAllCaps="false" android:textColor="#206E60" android:textSize="15sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="AI 辅助" android:textSize="20sp" android:textColor="#182431" android:layout_marginBottom="12dp" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="本地未命中时使用。无需 AI 时可留空 Key。" android:textSize="13sp" android:textColor="#708078" android:layout_marginBottom="12dp"/>
            <Spinner android:id="@+id/spinner_preset" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="12dp"/>
            <EditText android:id="@+id/et_endpoint" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="12dp" android:padding="12dp" android:background="@drawable/yx_soft" android:hint="接口地址" android:textSize="14sp" android:singleLine="true" android:inputType="textUri"/>
            <EditText android:id="@+id/et_model" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="12dp" android:padding="12dp" android:background="@drawable/yx_soft" android:hint="模型名称" android:textSize="14sp" android:singleLine="true" android:inputType="textUri"/>
            <EditText android:id="@+id/et_api_key" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="12dp" android:padding="12dp" android:background="@drawable/yx_soft" android:hint="API Key" android:textSize="14sp" android:singleLine="true" android:inputType="textPassword"/>
            <CheckBox android:id="@+id/check_show_key" android:layout_width="wrap_content" android:layout_height="48dp" android:text="显示 Key"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:textColor="#182431" android:layout_marginBottom="12dp" android:id="@+id/tv_key_status"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_save_ai" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="10dp" android:background="@drawable/yx_primary" android:text="保存 AI 配置" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="15sp"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_test_ai" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="10dp" android:background="@drawable/yx_soft" android:text="测试连接" android:textAllCaps="false" android:textColor="#206E60" android:textSize="15sp"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_reset_ai" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="10dp" android:background="@drawable/yx_soft" android:text="恢复默认接口" android:textAllCaps="false" android:textColor="#206E60" android:textSize="15sp"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_stop" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="10dp" android:background="@drawable/yx_soft" android:text="停止屏幕采集" android:textAllCaps="false" android:textColor="#206E60" android:textSize="15sp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
